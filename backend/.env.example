# Configuración del Backend de Dominio Estudio
PORT=4000

# Motor de Base de Datos: 'sqlite' (por defecto, sin configuración) o 'mysql'
DB_CLIENT=sqlite

# Variables para MySQL (cuando DB_CLIENT=mysql o despliegue en Docker)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=dominio_estudio
